{
  "name": "pinyin-dict",
  "private": true,
  "description": "輸入漢字，查出對應的拼音輸入。離線可用的網頁版字典。",
  "scripts": {
    "data": "python3 tools/build_data.py",
    "icons": "python3 tools/build_icons.py",
    "stamp": "python3 tools/stamp_version.py",
    "serve": "python3 -m http.server 8788 --directory public",
    "deploy": "npm run stamp && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
